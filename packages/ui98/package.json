{
  "name": "ui98",
  "version": "0.1.0",
  "description": "Retro React components: Windows 95, GeoCities, Y2K and the 88x31 button wall. Built on Base UI and Tailwind CSS.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "react",
    "components",
    "ui",
    "windows-95",
    "retro",
    "geocities",
    "y2k",
    "base-ui",
    "tailwindcss",
    "88x31"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4N1Z/ui98.git",
    "directory": "packages/ui98"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./win95.css": "./dist/win95.css",
    "./geocities.css": "./dist/geocities.css",
    "./y2k.css": "./dist/y2k.css",
    "./88x31.css": "./dist/88x31.css",
    "./tailwind/*.css": "./dist/tailwind/*.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": "^18.2 || ^19",
    "react-dom": "^18.2 || ^19"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "0.474.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.2"
  }
}
